{
  "name": "Blinko → Ollama Proxy",
  "nodes": [
    {
      "parameters": {
        "path": "blinko-capture",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "blinko-capture"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://YOUR_LAPTOP_TAILSCALE_IP:11434/api/generate",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "={{ $json.body.model || \"llama3.2\" }}"
            },
            {
              "name": "prompt",
              "value": "={{ $json.body.prompt || $json.body.content || $json.body.message }}"
            },
            {
              "name": "stream",
              "value": false
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "ollama-node",
      "name": "Forward to Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "response-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [690, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Forward to Ollama",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward to Ollama": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
